# Sway desktop session. Login on local TTY1 starts it through ~/.zshrc.
# The launcher remains usable manually as: sway-start

set $mod Mod4
set $term kitty
set $launcher rofi -show drun -normal-window
set $switcher env -u WAYLAND_DISPLAY rofi -show combi -normal-window

font pango:Noto Sans Mono CJK JP, Symbols Nerd Font 12
floating_modifier $mod normal
focus_follows_mouse yes
xwayland enable

default_border pixel 1
gaps inner 12
client.focused          #00ced1 #00ced1 #008b8b #008b8b
client.focused_inactive #000000 #000000 #000000 #000000

# Match the current X11 layout (3840x3240 total):
#
#   +-----------------------+
#   |       DP-1 4K         |
#   +-----------+-----------+
#   | DVI-I-1   | HDMI-A-1  |
#   +-----------+-----------+
#
# Connector names come from /sys/class/drm. Refresh rates are intentionally
# omitted so Sway can choose each display's advertised preferred 60 Hz mode.
set $output_top DP-1
set $output_bottom_left DVI-I-1
set $output_bottom_right HDMI-A-1

output $output_top mode 3840x2160 position 0 0 scale 1
output $output_bottom_left mode 1920x1080 position 0 2160 scale 1
output $output_bottom_right mode 1920x1080 position 1920 2160 scale 1

input type:keyboard {
    repeat_delay 150
    repeat_rate 230
}

# Keep the Keyball's adaptive acceleration curve, but reduce its base speed.
input "22871:512:aikawa_Keyball39ish_Mouse" {
    pointer_accel -0.3
}

# Applications
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym XF86AudioMute exec $switcher
bindsym Mod1+v exec $launcher
bindsym Ctrl+semicolon exec copyq toggle
bindsym $mod+space exec $HOME/.config/sway/scripts/kitty-vivaldi-toggle.sh

# Focus
bindsym $mod+semicolon focus left
bindsym $mod+slash focus down
bindsym $mod+bracketleft focus up
bindsym $mod+apostrophe focus right

# Layout
bindsym $mod+Shift+h split h
bindsym $mod+Shift+v split v
bindsym $mod+Shift+space fullscreen toggle
bindsym $mod+Shift+s layout stacking
bindsym $mod+Shift+w layout tabbed
bindsym $mod+Shift+e layout toggle split
bindsym $mod+Shift+f floating toggle

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Keep the initial three workspaces on their matching physical displays.
workspace $ws1 output $output_top
workspace $ws2 output $output_bottom_left
workspace $ws3 output $output_bottom_right

bindsym Mod1+Tab workspace next
bindsym Mod1+Shift+Tab workspace prev

bindsym $mod+Shift+c reload
bindsym $mod+Escape restart

mode "win-edit" {
    bindsym $mod+semicolon focus left
    bindsym $mod+slash focus down
    bindsym $mod+bracketleft focus up
    bindsym $mod+apostrophe focus right

    bindsym $mod+Shift+semicolon resize shrink width 5 px or 5 ppt
    bindsym $mod+Shift+slash resize grow height 5 px or 5 ppt
    bindsym $mod+Shift+bracketleft resize shrink height 5 px or 5 ppt
    bindsym $mod+Shift+apostrophe resize grow width 5 px or 5 ppt

    bindsym $mod+Ctrl+semicolon move left
    bindsym $mod+Ctrl+slash move down
    bindsym $mod+Ctrl+bracketleft move up
    bindsym $mod+Ctrl+apostrophe move right

    bindsym $mod+Ctrl+l move workspace to output left
    bindsym $mod+Ctrl+j move workspace to output down
    bindsym $mod+Ctrl+k move workspace to output up
    bindsym $mod+Ctrl+h move workspace to output right

    bindsym F1 workspace $ws1
    bindsym F2 workspace $ws2
    bindsym F3 workspace $ws3
    bindsym F4 workspace $ws4
    bindsym F5 workspace $ws5
    bindsym F6 workspace $ws6
    bindsym F7 workspace $ws7
    bindsym F8 workspace $ws8
    bindsym F9 workspace $ws9
    bindsym F10 workspace $ws10

    bindsym $mod+Shift+1 move container to workspace $ws1
    bindsym $mod+Shift+2 move container to workspace $ws2
    bindsym $mod+Shift+3 move container to workspace $ws3
    bindsym $mod+Shift+4 move container to workspace $ws4
    bindsym $mod+Shift+5 move container to workspace $ws5
    bindsym $mod+Shift+6 move container to workspace $ws6
    bindsym $mod+Shift+7 move container to workspace $ws7
    bindsym $mod+Shift+8 move container to workspace $ws8
    bindsym $mod+Shift+9 move container to workspace $ws9
    bindsym $mod+Shift+0 move container to workspace $ws10

    bindsym $mod+Ctrl+1 move workspace to output $output_top
    bindsym $mod+Ctrl+2 move workspace to output $output_bottom_left
    bindsym $mod+Ctrl+3 move workspace to output $output_bottom_right

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym Ctrl+bracketleft mode "default"
    bindsym $mod+e mode "default"
}
bindsym $mod+e mode "win-edit"

# Native Wayland clients identify themselves with app_id. The class variants
# retain equivalent behavior when an application falls back to Xwayland.
assign [app_id="Alacritty"] $ws2
assign [class="Alacritty"] $ws2
assign [app_id="luakit"] $ws2
assign [class="Luakit"] $ws2
assign [app_id="org.remmina.Remmina"] $ws3
assign [class="Remmina"] $ws3

for_window [app_id="copyq"] floating enable, move position center
for_window [class="copyq"] floating enable, move position center
for_window [class="Rofi"] floating enable, move position center
for_window [app_id="fcitx5-config-qt"] floating enable, resize set 600 400
for_window [class="fcitx5-config-qt"] floating enable, resize set 600 400
for_window [app_id="nm-connection-editor"] floating enable, resize set 800 600
for_window [class="nm-connection-editor"] floating enable, resize set 800 600
for_window [app_id="mozc_tool"] floating enable, resize set 600 400
for_window [class="mozc_tool"] floating enable, resize set 600 400
for_window [window_role="pop-up"] floating enable, move position center
for_window [window_role="task_dialog"] floating enable

# Keep D-Bus/systemd-activated applications on the same desktop and input-method
# environment as programs launched directly by Sway.
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE GTK_IM_MODULE QT_IM_MODULE XMODIFIERS GLFW_IM_MODULE GDK_BACKEND QT_QPA_PLATFORM MOZ_ENABLE_WAYLAND
exec_always $HOME/.config/sway/scripts/update-tmux-environment.sh

# Match the Wayland-independent startup commands from the i3 session. These
# start the services for this login without enabling them at boot.
exec sudo rawhid-rust
exec fcitx5 -d -r
exec copyq
exec $HOME/.config/sway/scripts/configure-copyq-wayland.sh
exec insync start
exec swayidle -w
exec sudo systemctl start dhcpcd@enp5s0.service
exec sudo systemctl start docker
exec sudo systemctl start sshd
exec sudo chronyd -q 'pool pool.ntp.org iburst'

# Let Sway own Waybar's lifecycle and restrict both Sway and Waybar to the
# upper display.
bar {
    output $output_top
    swaybar_command waybar
}

# Always keep an obvious way back to the TTY during display testing.
bindsym $mod+Shift+Escape exec swaynag -t warning -m 'Exit the Sway session?' -b 'Exit Sway' 'swaymsg exit'
# Emergency exit when the outputs are unusable and the confirmation is hidden.
bindsym $mod+Ctrl+Shift+Escape exit

# Intentionally not started under Sway:
# - xrandr and polybar: X11-only display/bar configuration
# - ~/.config/i3/layout_manager.sh: depends on xdotool/xprop/xrandr
# - xhost and xremap-x11: X11-only
