configuration {
    font: "Noto Sans CJK JP 12";
}

* {
    background: #2d2d2d;
    foreground: #ffffff;
}

window {
    location: northeast;
    anchor: northeast;
    y-offset: 42px;
    width: 580px;
    background-color: @background;
    border: 1px;
    border-color: #555555;
    border-radius: 8px;
    padding: 4px;
}

mainbox {
    background-color: transparent;
    children: [ listview ];
}

listview {
    background-color: transparent;
    layout: vertical;
    lines: 1;
    columns: 4;
    fixed-columns: true;
    expand: false;
    spacing: 4px;
    scrollbar: false;
    fixed-height: true;
}

element {
    background-color: transparent;
    text-color: @foreground;
    border-radius: 5px;
    padding: 5px 6px;
}

element selected.normal {
    background-color: transparent;
    text-color: @foreground;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    horizontal-align: 0.5;
}

element-text selected.normal {
    font: "Noto Sans CJK JP Bold 12";
}
