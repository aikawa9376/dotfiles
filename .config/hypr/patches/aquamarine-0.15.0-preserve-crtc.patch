--- a/src/backend/drm/DRM.cpp
+++ b/src/backend/drm/DRM.cpp
@@ -979,5 +979,10 @@
-        // disabled outputs release their CRTCs so active outputs get priority
-        if (c->crtc && c->status == DRM_MODE_CONNECTED && c->output && !c->output->enabledState) {
+        // Local NVIDIA KVM workaround: DPMS-off must not move a connected
+        // output to another CRTC while newly connected outputs take its slot.
+        // Opt-in only: retaining slots can limit hotplug on CRTC-starved GPUs.
+        const auto preserve = getenv("AQ_NVIDIA_PRESERVE_CRTC");
+        const bool preserveSleeping = driver == AQ_BACKEND_GPU_DRIVER_NVIDIA && preserve && std::string_view{preserve} == "1";
+        // Otherwise disabled outputs release their CRTCs so active outputs get priority.
+        if (!preserveSleeping && c->crtc && c->status == DRM_MODE_CONNECTED && c->output && !c->output->enabledState) {
             backend->log(AQ_LOG_DEBUG, std::format("drm: {} is disabled, releasing crtc {}", c->szName, c->crtc->id));
             c->setCRTC(nullptr);
         }
